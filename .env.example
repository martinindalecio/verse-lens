# Server-side only. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Neon Postgres. The pooled URL is what the app uses; the unpooled one is only for local scripts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Salt for hashing client IPs in the per-client daily quotas (client_days). Set a long random
# value in production (e.g. `openssl rand -hex 32`); without it a fixed fallback is used.
CLIENT_HASH_SALT=

# Optional limits (non-negative integers; 0 turns the feature off for everyone/each client).
# DAILY_GENERATION_CAP=200
# DAILY_GENERATION_PER_CLIENT=20
# REPORTS_DAILY_CAP=500
# REPORTS_PER_CLIENT=20
